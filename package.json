{
  "name": "veo3auto",
  "version": "1.0.68",
  "description": "Veo3 Automation Desktop App",
  "main": "main.js",
  "author": "Veo3 Team",
  "build": {
    "appId": "com.veo3.auto",
    "productName": "Veo3 Auto",
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Veo3.Auto.Setup.${version}.${ext}"
    },
    "files": [
      "**/*",
      "!dist/**/*",
      "!user_data/**/*",
      "!node_modules/puppeteer/.local-chromium/**/*"
    ],
    "asar": true,
    "publish": [
      {
        "provider": "github",
        "owner": "starbuckskohii-rgb",
        "repo": "veo3auto"
      }
    ]
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "start": "electron .",
    "dev": "set NO_AUTH=true && electron .",
    "dist": "electron-builder",
    "build:secure": "node build_secure.js"
  },
  "keywords": [],
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "clipboardy": "^2.3.0",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "express": "^5.2.1",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "node-machine-id": "^1.1.12",
    "open": "^11.0.0",
    "otpauth": "^9.5.0",
    "otplib": "^13.3.0",
    "puppeteer": "^24.37.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "puppeteer-real-browser": "^1.4.4",
    "socket.io": "^4.8.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^34.1.1",
    "electron-builder": "^25.1.8",
    "javascript-obfuscator": "^5.3.0",
    "pkg": "^5.8.1"
  }
}